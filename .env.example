# ChatterSnap — optional configuration
#
# Copy this file to `.env` and edit. Nothing here is required: with no .env the
# app runs and translates directly from the browser.
#
#   npm run dev     → Vite dev server on http://127.0.0.1:5173
#                     (also starts this proxy if .env exists)
#   npm start       → build must exist; serves dist/ + the API on :8787
#
# NEVER commit a real .env — it is git-ignored. Keys stay server-side and are
# never bundled into the browser JavaScript.

# Port for the helper server (proxy + optional static serving).
PORT=8787

# LibreTranslate-compatible endpoint the proxy forwards to.
# Self-hosted example: http://localhost:5000/translate
LIBRE_ENDPOINT=https://libretranslate.com/translate

# API key for that endpoint. Empty = send the request without a key, which most
# public hosts reject. Leave blank unless you are using a key-gated instance.
LIBRE_API_KEY=
